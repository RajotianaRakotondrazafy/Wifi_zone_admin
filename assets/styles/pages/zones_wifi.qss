/* ================================================================
   PAGE ZONES WIFI
   ================================================================ */

QFrame#zoneCard {
    background-color: #282826;
    border-radius: 14px;
    border: 1px solid #2e2e2b;
}
QFrame#zoneCard[statut="actif"]   { border: 1px solid rgba(74, 222, 128, 0.35); border-left: 3px solid #4ade80; }
QFrame#zoneCard[statut="inactif"] { border: 1px solid rgba(248, 113, 113, 0.35); border-left: 3px solid #f87171; }
QFrame#zoneCard[statut="erreur"]  { border: 1px solid rgba(232, 196, 91, 0.35); border-left: 3px solid #e8c45b; }

QLabel#cercleIconeZoneActif   { background-color: rgba(74, 222, 128, 0.12); border-radius: 20px; border: 1px solid rgba(74, 222, 128, 0.25); }
QLabel#cercleIconeZoneInactif { background-color: rgba(248, 113, 113, 0.10); border-radius: 20px; border: 1px solid rgba(248, 113, 113, 0.25); }
QLabel#cercleIconeZoneErreur  { background-color: rgba(232, 196, 91, 0.10); border-radius: 20px; border: 1px solid rgba(232, 196, 91, 0.25); }

QLabel#nomZone       { color: #f1f1f1; font-size: 14px; font-weight: bold; }
QLabel#descriptionZone { color: #8b8d98; font-size: 12px; }
QLabel#ipZone        { color: #5b6ee8; font-size: 12px; font-weight: bold; }

/* Badges état zone */
QLabel#badgeZoneActif   { background-color: rgba(74, 222, 128, 0.10); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.28); border-radius: 5px; font-size: 11px; font-weight: bold; padding: 1px 7px; }
QLabel#badgeZoneInactif { background-color: rgba(248, 113, 113, 0.10); color: #f87171; border: 1px solid rgba(248, 113, 113, 0.28); border-radius: 5px; font-size: 11px; font-weight: bold; padding: 1px 7px; }
QLabel#badgeZoneErreur  { background-color: rgba(232, 196, 91, 0.10); color: #e8c45b; border: 1px solid rgba(232, 196, 91, 0.28); border-radius: 5px; font-size: 11px; font-weight: bold; padding: 1px 7px; }
QLabel#badgeProfilActif { background-color: rgba(74, 222, 128, 0.10); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.25); border-radius: 5px; font-size: 11px; font-weight: bold; padding: 1px 7px; }
QLabel#badgeProfilInactif { background-color: rgba(92, 95, 110, 0.18); color: #8b8d98; border: 1px solid rgba(92, 95, 110, 0.28); border-radius: 5px; font-size: 11px; padding: 1px 7px; }

/* Tableau profils */
QFrame#tableauProfils {
    background-color: rgba(26, 26, 25, 0.60);
    border: 1px solid #2a2a28;
    border-radius: 9px;
}
QWidget#ligneProfilWifi { background-color: transparent; }
QWidget#ligneProfilWifi:hover { background-color: rgba(255, 255, 255, 0.03); }
QWidget#ligneProfilWifi[inactif="true"] { background-color: rgba(26, 26, 25, 0.40); }
QWidget#ligneProfilWifi[inactif="true"]:hover { background-color: rgba(248, 113, 113, 0.04); }
QWidget#ligneProfilWifi[inactif="true"] QLabel#nomUtilisateur { color: #8b8d98; }
QWidget#ligneProfilWifi[inactif="true"] QLabel#loginUtilisateur,
QWidget#ligneProfilWifi[inactif="true"] QLabel#montantVente { color: #5c5f6e; }

QPushButton#boutonActionActiver {
    background-color: transparent;
    border: 1px solid #363633;
    border-radius: 6px;
    color: #d1d2d8;
    font-size: 12px;
    padding: 0 14px;
    min-height: 30px;
    min-width: 72px;
}
QPushButton#boutonActionActiver:hover {
    border-color: #4ade80;
    color: #4ade80;
    background-color: rgba(74, 222, 128, 0.07);
}

/* Dialog profil / zone */
QFrame#pageDialogProfil,
QFrame#pageDialogZone { background-color: #20201f; }

QLabel#titreDialog { color: #f1f1f1; font-size: 18px; font-weight: bold; }

QLabel#badgeStatutDialog { border-radius: 5px; font-size: 11px; font-weight: bold; padding: 3px 10px; }
QLabel#badgeStatutDialog[actif="true"]  { background-color: rgba(74, 222, 128, 0.10); color: #4ade80; border: 1px solid rgba(74, 222, 128, 0.28); }
QLabel#badgeStatutDialog[actif="false"] { background-color: rgba(92, 95, 110, 0.18); color: #8b8d98; border: 1px solid rgba(92, 95, 110, 0.28); }

QFrame#encartStatut {
    background-color: rgba(26, 26, 25, 0.60);
    border: 1px solid #2a2a28;
    border-radius: 8px;
}
QLabel#encartStatutTexte { color: #8b8d98; font-size: 12px; }
