/* ================================================================
   PAGE PARAMÈTRES
   ================================================================ */

QFrame#sectionParametres {
    background-color: #282826;
    border-radius: 14px;
    border: 1px solid #2e2e2b;
}

QLabel#titreSectionParametres {
    color: #8b8d98;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
}

QLabel#labelParametre { color: #8b8d98; font-size: 13px; }

QLineEdit#champParametres {
    background-color: #1c1c1b;
    border: 1px solid #363633;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 38px;
    color: #f1f1f1;
    font-size: 13px;
}
QLineEdit#champParametres:focus { border-color: #5b6ee8; }
QLineEdit#champParametres:hover { border-color: #4a4a47; }
QLineEdit#champParametres::placeholder { color: #5c5f6e; }

QPushButton#boutonSauvegarder {
    background-color: #5b6ee8;
    color: #ffffff;
    border: none;
    border-radius: 9px;
    padding: 0 36px;
    min-height: 44px;
    font-size: 14px;
    font-weight: bold;
}
QPushButton#boutonSauvegarder:hover   { background-color: #6d7ded; }
QPushButton#boutonSauvegarder:pressed { background-color: #4856c4; }
