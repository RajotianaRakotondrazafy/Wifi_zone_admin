/* ================================================================
   THEME SOMBRE — FICHIER MAÎTRE
   Palette de base :
     bg principal  : #20201f  (HSL 60° 1.59% 12.35%)
     bg panels     : #282826  (+3% lightness)
     bg sidebar    : #1a1a19  (-2% lightness)
     bg inputs     : #1c1c1b
     border subtle : #2e2e2b
     border fort   : #363633
     accent        : #5b6ee8
     texte         : #f1f1f1 / #8b8d98 / #5c5f6e
   ================================================================ */

QWidget {
    background-color: #20201f;
    color: #f1f1f1;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 14px;
    outline: none;
}

/* Les labels héritent du fond de leur parent, pas du fond global */
QLabel { background-color: transparent; }

QWidget, QLineEdit, QTextEdit, QSpinBox {
    selection-background-color: #5b6ee8;
    selection-color: #ffffff;
}

QToolTip {
    background-color: #282826;
    color: #d1d2d8;
    border: 1px solid #363633;
    border-radius: 6px;
    padding: 5px 9px;
    font-size: 12px;
}

@import "pages/communs.qss";
@import "pages/login.qss";
@import "pages/tableau_de_bord.qss";
@import "pages/utilisateurs.qss";
@import "pages/zones_wifi.qss";
@import "pages/statistiques.qss";
@import "pages/blocages.qss";
@import "pages/parametres.qss";
@import "pages/ventes.qss";
@import "pages/stock.qss";
