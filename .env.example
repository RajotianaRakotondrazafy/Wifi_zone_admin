# ============================================================
#  E-Konnekta — Configuration
#  Copiez ce fichier en ".env" et remplissez les valeurs.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=WiFi Zone
APP_ENV=production        # "dev" active le hot-reload et saute le login

# ── Base de données ──────────────────────────────────────────
# Chemin vers le fichier SQLite (relatif à la racine du projet)
# Laissez vide pour utiliser le chemin par défaut : database/app.db
DATABASE_PATH=

# ── Chiffrement ──────────────────────────────────────────────
# Clé Fernet pour chiffrer les mots de passe MikroTik en base.
# Laissez VIDE : une clé sera générée automatiquement au premier démarrage.
# /!\ Ne partagez jamais cette clé — sans elle, les mots de passe
#     stockés en base ne peuvent plus être déchiffrés.
FERNET_KEY=

# ── Tarification (valeurs par défaut, modifiables dans Paramètres) ─
TARIFICATION_PRIX_PAR_HEURE=1000
TARIFICATION_DEBIT_DEFAUT_MBPS=2
TARIFICATION_LIBRE_MIN_AR=500
TARIFICATION_LIBRE_MIN_MIN=30

# ── Portail WiFi ────────────────────────────────────────────────────
# Adresse du portail hotspot (IP ou DNS) affichée sur les tickets
# et encodée dans les QR codes de connexion.
HOTSPOT_LOGIN_IP=192.168.88.1
